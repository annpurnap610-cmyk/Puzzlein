    <!-- About Screen -->
    <string name="about_title">About SlideGrid</string>
    <string name="about_overview">SlideGrid is an offline-first native Android sliding number puzzle built around tactile response, mathematically guaranteed solvable boards, and zero-distraction gameplay.</string>
    <string name="about_how_to_play_title">How to Play</string>
    <string name="about_how_to_play_body">1. Choose 3×3 Relaxed, 4×4 Classic, or 5×5 Master.\n2. Tap any tile in the same row or column as the empty recess to slide one or multiple tiles.\n3. Arrange numbers 1 through N in ascending left-to-right order with the empty recess in the bottom-right corner.</string>
    <string name="about_privacy_title">Privacy &amp; Offline Guarantee</string>
    <string name="about_privacy_body">SlideGrid operates 100% offline. It requests zero device permissions, makes zero network connections, and stores only your local game records and preferences on your device.</string>
